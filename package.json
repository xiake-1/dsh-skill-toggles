{
  "name": "dsh-skill-toggles",
  "version": "0.6.1",
  "description": "按分组开关 DSH 技能：生效集合 = 各启用分组的并集；带输入框面板、自带技能分组与 9 个 skill_toggles_* 工具",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiake-1/dsh-skill-toggles.git"
  },
  "homepage": "https://github.com/xiake-1/dsh-skill-toggles#readme",
  "bugs": {
    "url": "https://github.com/xiake-1/dsh-skill-toggles/issues"
  },
  "scripts": {
    "postuninstall": "node scripts/cleanup.mjs",
    "test": "node test/state.test.mjs && node test/host-smoke.test.mjs && node test/client-render.test.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "skill-toggles",
    "skill-filter"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      },
      "node": ">=18"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
